{
  "name": "progress-bar",
  "version": "1.0.0",
  "description": "Stop staring at a spinner. Juggling several tasks? One glance tells you exactly where Claude is: the plan, the step it's on, and what's left, live above your prompt.",
  "author": {
    "name": "Jimmy Pellerin"
  },
  "license": "MIT",
  "homepage": "https://github.com/Gimzki/claude-code-progress-bar",
  "repository": "https://github.com/Gimzki/claude-code-progress-bar",
  "documentationUrl": "https://github.com/Gimzki/claude-code-progress-bar#readme",
  "supportUrl": "https://github.com/Gimzki/claude-code-progress-bar/issues",
  "privacyPolicyUrl": "https://github.com/Gimzki/claude-code-progress-bar#what-it-reads-and-sends",
  "keywords": [
    "progress",
    "progress-bar",
    "steps",
    "mod",
    "ui"
  ],
  "types": "./types/index.d.ts",
  "userConfig": {
    "language": {
      "type": "string",
      "title": "Language",
      "description": "Language of the bar and of the panel: en (English) or fr (French).",
      "default": "en",
      "options": [
        "en",
        "fr"
      ]
    }
  }
}
